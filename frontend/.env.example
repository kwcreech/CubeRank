# Supabase Auth (browser-safe publishable key)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Spring Boot API (no trailing slash)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Manual (Supabase Dashboard → Authentication → URL configuration):
# Site URL: http://localhost:3000 (or your prod origin)
# Redirect allow list (no custom SMTP / email template required for reset):
#   http://localhost:3000/auth/confirm
# Default recovery emails land on redirectTo with ?code=; the app exchanges
# that at /auth/confirm and continues to /auth/update-password.
#
# Storage (Settings → avatar upload):
# Create a public bucket named `avatars`.
# Path convention: {userId}/{timestamp}.{ext}
# Policies need INSERT + SELECT + UPDATE for authenticated upserts,
# and public SELECT (or equivalent) so avatar URLs work in the UI.
