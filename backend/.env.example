# Copy to backend/.env and fill in real values. backend/.env is gitignored.

# --- Supabase Postgres (JDBC) ---
# Use the Session pooler or direct connection string from Supabase → Settings → Database.
# Must start with jdbc:postgresql://
DATABASE_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=

# --- Supabase Auth (JWT validation) ---
# Issuer is typically: https://YOUR_PROJECT_REF.supabase.co/auth/v1
SUPABASE_ISSUER_URI=https://YOUR_PROJECT_REF.supabase.co/auth/v1
# JWKS (ECC current key): https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# --- App ---
FRONTEND_ORIGIN=http://localhost:3000
PORT=8080

# Shared secret for POST /api/internal/catalog/ingest (GitHub Actions + admin trigger)
INGEST_CRON_SECRET=change-me-to-a-long-random-string

# --- OpenAI ---
OPENAI_API_KEY=

# Bayesian leaderboard prior strength (optional)
LEADERBOARD_PRIOR_STRENGTH=8
