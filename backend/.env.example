# Copy to backend/.env and fill in real values. backend/.env is gitignored.

# --- Supabase Postgres (JDBC) ---
# Prefer Session pooler (IPv4). Direct db.YOUR_REF.supabase.co is IPv6-only and
# fails on many networks with UnknownHostException / connection attempt failed.
# Dashboard: Project Settings → Database → Connection string → Session pooler.
# Must start with jdbc:postgresql://
# Username for pooler is postgres.YOUR_PROJECT_REF (not just postgres).
DATABASE_URL=jdbc:postgresql://aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres.YOUR_PROJECT_REF
DATABASE_PASSWORD=

# --- Supabase Auth (JWT validation) ---
# Issuer is typically: https://YOUR_PROJECT_REF.supabase.co/auth/v1
SUPABASE_ISSUER_URI=https://YOUR_PROJECT_REF.supabase.co/auth/v1
# JWKS (ECC current key): https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# --- App ---
FRONTEND_ORIGIN=http://localhost:3000
PORT=8080

# Shared secret for POST /api/internal/catalog/ingest (GitHub Actions + admin trigger)
INGEST_CRON_SECRET=change-me-to-a-long-random-string

# --- OpenAI (embeddings + RAG assistant; required for /api/assistant and review embedding) ---
OPENAI_API_KEY=

# Bayesian leaderboard prior strength (optional)
LEADERBOARD_PRIOR_STRENGTH=8

# Assistant limits live in application.yml under app.assistant
# (max-prompt-chars=500, rate-limit-per-hour=3, ip-rate-limit-per-hour=6, retrieval-k=6).
